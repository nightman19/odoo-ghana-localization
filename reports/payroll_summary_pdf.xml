<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Payroll Summary PDF Report Template -->
        <template id="report_payroll_summary_pdf">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 12px;">
                        <!-- Header -->
                        <div class="text-center" style="border-bottom: 3px solid #875A7B; padding-bottom: 15px; margin-bottom: 20px;">
                            <h3 style="margin: 5px 0; color: #875A7B;">PAYROLL SUMMARY REPORT</h3>
                            <h5 style="margin: 5px 0; color: #666;">
                                <t t-if="data and data.get('period')" t-esc="data.get('period')"/>
                                <t t-else="" t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %Y')"/>
                            </h5>
                        </div>

                        <!-- Company Info -->
                        <div style="background-color: #f8f9fa; padding: 10px; border-radius: 5px; margin-bottom: 20px;">
                            <div class="row">
                                <div class="col-6">
                                    <strong>Company:</strong> <span t-esc="env.company.name"/>
                                </div>
                                <div class="col-6 text-right">
                                    <strong>Report Period:</strong> 
                                    <t t-if="data and data.get('period')" t-esc="data.get('period')"/>
                                    <t t-else="" t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %Y')"/>
                                </div>
                            </div>
                        </div>

                        <!-- Employee Summary Table -->
                        <table class="table table-sm table-bordered" style="margin-bottom: 20px;">
                            <thead style="background-color: #875A7B; color: white;">
                                <tr>
                                    <th style="padding: 8px;">Employee Name</th>
                                    <th style="padding: 8px;">Department</th>
                                    <th class="text-right" style="padding: 8px;">Basic Salary</th>
                                    <th class="text-right" style="padding: 8px;">Gross Salary</th>
                                    <th class="text-right" style="padding: 8px;">PAYE Tax</th>
                                    <th class="text-right" style="padding: 8px;">SSNIT (Employee)</th>
                                    <th class="text-right" style="padding: 8px;">SSNIT (Employer)</th>
                                    <th class="text-right" style="padding: 8px;">Net Salary</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_basic" t-value="0"/>
                                <t t-set="total_gross" t-value="0"/>
                                <t t-set="total_paye" t-value="0"/>
                                <t t-set="total_ssnit_emp" t-value="0"/>
                                <t t-set="total_ssnit_empr" t-value="0"/>
                                <t t-set="total_net" t-value="0"/>
                                
                                <t t-foreach="docs" t-as="employee">
                                    <tr>
                                        <td style="padding: 6px;"><span t-field="employee.name"/></td>
                                        <td style="padding: 6px;">
                                            <span t-field="employee.department_id.name" t-if="employee.department_id"/>
                                            <span t-else="">N/A</span>
                                        </td>
                                        <td class="text-right" style="padding: 6px;">
                                            <span t-esc="'{:,.2f}'.format(employee.basic_salary or 0)"/>
                                        </td>
                                        <td class="text-right" style="padding: 6px;">
                                            <span t-esc="'{:,.2f}'.format(employee.gross_salary or 0)"/>
                                        </td>
                                        <td class="text-right" style="padding: 6px;">
                                            <span t-esc="'{:,.2f}'.format(employee.paye_tax or 0)"/>
                                        </td>
                                        <td class="text-right" style="padding: 6px;">
                                            <span t-esc="'{:,.2f}'.format(employee.ssnit_employee or 0)"/>
                                        </td>
                                        <td class="text-right" style="padding: 6px;">
                                            <span t-esc="'{:,.2f}'.format(employee.ssnit_employer or 0)"/>
                                        </td>
                                        <td class="text-right" style="padding: 6px;">
                                            <span t-esc="'{:,.2f}'.format(employee.net_salary or 0)"/>
                                        </td>
                                    </tr>
                                    
                                    <!-- Update totals -->
                                    <t t-set="total_basic" t-value="total_basic + (employee.basic_salary or 0)"/>
                                    <t t-set="total_gross" t-value="total_gross + (employee.gross_salary or 0)"/>
                                    <t t-set="total_paye" t-value="total_paye + (employee.paye_tax or 0)"/>
                                    <t t-set="total_ssnit_emp" t-value="total_ssnit_emp + (employee.ssnit_employee or 0)"/>
                                    <t t-set="total_ssnit_empr" t-value="total_ssnit_empr + (employee.ssnit_employer or 0)"/>
                                    <t t-set="total_net" t-value="total_net + (employee.net_salary or 0)"/>
                                </t>
                            </tbody>
                            <tfoot style="background-color: #f8f9fa; font-weight: bold;">
                                <tr>
                                    <td colspan="2" style="padding: 8px;">TOTALS</td>
                                    <td class="text-right" style="padding: 8px;">
                                        <span t-esc="'{:,.2f}'.format(total_basic)"/>
                                    </td>
                                    <td class="text-right" style="padding: 8px;">
                                        <span t-esc="'{:,.2f}'.format(total_gross)"/>
                                    </td>
                                    <td class="text-right" style="padding: 8px;">
                                        <span t-esc="'{:,.2f}'.format(total_paye)"/>
                                    </td>
                                    <td class="text-right" style="padding: 8px;">
                                        <span t-esc="'{:,.2f}'.format(total_ssnit_emp)"/>
                                    </td>
                                    <td class="text-right" style="padding: 8px;">
                                        <span t-esc="'{:,.2f}'.format(total_ssnit_empr)"/>
                                    </td>
                                    <td class="text-right" style="padding: 8px;">
                                        <span t-esc="'{:,.2f}'.format(total_net)"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Summary Cards -->
                        <div class="row" style="margin-top: 30px;">
                            <div class="col-4">
                                <div style="background-color: #e8f5e9; border-left: 4px solid #28a745; padding: 15px;">
                                    <h6 style="margin: 0; color: #28a745;">Total Gross Payroll</h6>
                                    <h4 style="margin: 5px 0;">GHS <span t-esc="'{:,.2f}'.format(total_gross)"/></h4>
                                </div>
                            </div>
                            <div class="col-4">
                                <div style="background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 15px;">
                                    <h6 style="margin: 0; color: #856404;">Total Deductions</h6>
                                    <h4 style="margin: 5px 0;">GHS <span t-esc="'{:,.2f}'.format(total_paye + total_ssnit_emp)"/></h4>
                                </div>
                            </div>
                            <div class="col-4">
                                <div style="background-color: #e7f3ff; border-left: 4px solid #2196F3; padding: 15px;">
                                    <h6 style="margin: 0; color: #1976D2;">Total Net Payroll</h6>
                                    <h4 style="margin: 5px 0;">GHS <span t-esc="'{:,.2f}'.format(total_net)"/></h4>
                                </div>
                            </div>
                        </div>

                        <!-- Employer Costs -->
                        <div style="background-color: #ffebee; border: 1px solid #dc3545; padding: 15px; border-radius: 5px; margin-top: 20px;">
                            <h6 style="color: #dc3545; margin-top: 0;">Employer Contribution Summary</h6>
                            <div class="row">
                                <div class="col-6">
                                    <strong>SSNIT Employer (13%):</strong>
                                </div>
                                <div class="col-6 text-right">
                                    <strong>GHS <span t-esc="'{:,.2f}'.format(total_ssnit_empr)"/></strong>
                                </div>
                            </div>
                            <div class="row" style="border-top: 1px solid #dc3545; margin-top: 10px; padding-top: 10px;">
                                <div class="col-6">
                                    <strong>Total Company Cost:</strong>
                                </div>
                                <div class="col-6 text-right">
                                    <strong>GHS <span t-esc="'{:,.2f}'.format(total_gross + total_ssnit_empr)"/></strong>
                                </div>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="footer" style="margin-top: 30px; padding-top: 10px; border-top: 2px solid #ddd; text-align: center; font-size: 0.75em; color: #666;">
                            <p style="margin: 0;">
                                <strong>This is a computer-generated payslip.</strong> Please keep for your records.
                            </p>
                            <p style="margin: 0;">
                                Calculations compliant with Ghana Revenue Authority 2025 regulations.
                            </p>
                            <p style="margin: 0; font-size: 0.9em;">
                                Generated on: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y at %H:%M')"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <!-- Report Action -->
        <record id="action_report_payroll_summary_pdf" model="ir.actions.report">
            <field name="name">Payroll Summary</field>
            <field name="model">hr.employee</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gh_localization.report_payroll_summary_pdf</field>
            <field name="report_file">gh_localization.report_payroll_summary_pdf</field>
            <field name="print_report_name">'Payroll_Summary_%s_%s' % (object.month, object.year)</field>
        </record>
    </data>
</odoo>