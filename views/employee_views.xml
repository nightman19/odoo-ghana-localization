<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_ghana_payroll_form" model="ir.ui.view">
        <field name="name">hr.employee.ghana.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Ghana Payroll" name="ghana_payroll">

                    <group string="Tax Exemptions">
                        <field name="exempt_from_ssnit" widget="boolean_toggle"/>
                        <field name="exempt_from_paye"  widget="boolean_toggle"/>
                    </group>

                    <group string="Salary Components">
                        <group>
                            <field name="basic_salary"/>
                            <field name="transport_allowance"/>
                            <field name="housing_allowance"/>
                            <field name="gross_salary" readonly="1"/>
                        </group>
                    </group>

                    <group string="Overtime"
                           invisible="not company_id.enable_overtime">
                        <group>
                            <field name="overtime_enabled" widget="boolean_toggle"/>
                            <field name="overtime_method"
                                   invisible="not overtime_enabled"
                                   required="overtime_enabled"/>
                        </group>
                        <group invisible="not overtime_enabled">
                            <field name="overtime_amount_manual"
                                   invisible="overtime_method != 'monthly'"
                                   required="overtime_method == 'monthly' and overtime_enabled"/>
                            <field name="overtime_hours"
                                   invisible="overtime_method != 'hourly'"
                                   required="overtime_method == 'hourly' and overtime_enabled"/>
                            <field name="overtime_hourly_rate"
                                   invisible="overtime_method != 'hourly'"
                                   required="overtime_method == 'hourly' and overtime_enabled"/>
                            <field name="overtime_amount" readonly="1"/>
                        </group>
                    </group>

                    <group string="Deductions (Monthly)">
                        <group>
                            <field name="paye_tax"       readonly="1"/>
                            <field name="overtime_tax"   readonly="1"
                                   invisible="not overtime_enabled"/>
                            <field name="ssnit_employee" readonly="1"/>
                            <field name="ssnit_employer" readonly="1"
                                   string="SSNIT (Employer 13%)"/>
                        </group>
                        <group>
                            <field name="net_salary"         readonly="1"/>
                            <field name="company_total_cost" readonly="1"/>
                        </group>
                    </group>

                </page>
            </notebook>
        </field>
    </record>
</odoo>
